{
  "name": "dev-file-viewer",
  "version": "3.1.2",
  "private": true,
  "description": "Privacy-first Chrome extension for Markdown, diff, source, and other developer file preview. V2 includes Markdown Table of Contents / Outline navigation with a low-distraction TOC popover.",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "zip": "npm run build && node scripts/zip.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.4",
    "mermaid": "^11.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.2.0",
    "esbuild": "^0.27.0",
    "eslint": "^10.5.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.4",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
